<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the network system extension.

  A template, filled by make-app.sh from the provisioning profile; the result lands in build/,
  which git ignores.

  The extension deliberately does NOT carry com.apple.developer.system-extension.install: only
  the app asks for extensions to be installed. The extension just runs.
-->
<plist version="1.0">
<dict>
	<key>com.apple.application-identifier</key>
	<string>TEAM_ID_PLACEHOLDER.nyc.rao.pelican.tunnel</string>
	<key>com.apple.developer.team-identifier</key>
	<string>TEAM_ID_PLACEHOLDER</string>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>NE_PROVIDER_PLACEHOLDER</string>
	</array>
</dict>
</plist>
